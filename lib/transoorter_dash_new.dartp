                  style: TextStyle(fontSize: 14, color: _darkTeal),
                  // overflow: TextOverflow.ellipsis, // Allow wrapping instead
                  // maxLines: 1
              )),
        ]
      );
  }

  Widget _buildOrderInfoRow(Order order) {
    return Row(
        mainAxisAlignment: MainAxisAlignment.spaceBetween,
        children: [
          _buildInfoChip('Dist: ${order.estimatedDistance}'),
          _buildInfoChip('Time: ${order.estimatedTime}'),
          _buildInfoChip('Earn: \$${order.earnings.toStringAsFixed(2)}',
              color: _green, fontWeight: FontWeight.bold),
        ]);
  }

  Widget _buildInfoChip(String text, {Color color = _grey, FontWeight fontWeight = FontWeight.normal}) {
     return Container(
       padding: EdgeInsets.symmetric(horizontal: 8, vertical: 4),
       decoration: BoxDecoration(
           color: _lightGrey,
           borderRadius: BorderRadius.circular(8),
           border: Border.all(color: Colors.grey[300]!, width: 0.5)), // Fix: Use grey[300]!
       child: Text(text, style: TextStyle(fontSize: 12, color: color, fontWeight: fontWeight)),
     );
   }

  void _navigateToOrderDetails(Order order) {
     // Navigate and potentially pass a callback to refresh this list if status changes
     Navigator.push(
         context,
         MaterialPageRoute(
             builder: (_) => OrderDetailsScreen(
                   order: order,
                   transporterId: widget.transporterId,
                   onStatusUpdate: _loadInitialData, // Pass refresh function
                   autoNavigatePreference: _autoNavigate, // Pass preference
                 ))).then((_) {
                   // Optional: Refresh list when returning from details screen
                   // _loadInitialData();
                 });
   }


  Future<void> _handleAcceptOrder(Order order) async {
    // Confirmation Dialog
    bool confirm = await showDialog<bool>(
            context: context,
            builder: (BuildContext context) => AlertDialog(
                  title: Text('Accept Order?'),
                  content: Text('Do you want to accept Order #${order.orderId}?'),
                  actions: <Widget>[
                    TextButton(
                      child: Text('Cancel', style: TextStyle(color: _grey)),
                      onPressed: () => Navigator.of(context).pop(false),
                    ),
                    ElevatedButton( // Make Accept more prominent
                      child: Text('Accept'),
                       style: ElevatedButton.styleFrom(backgroundColor: _primaryTeal, foregroundColor: _white),
                      onPressed: () => Navigator.of(context).pop(true),
                    ),
                  ],
                )) ?? false; // Default to false if dialog dismissed

    if (confirm) {
      _showLoadingSnackbar("Accepting Order #${order.orderId}...");
      try {
        bool success = await TransporterApiService.acceptOrder(order.orderId, widget.transporterId); // Use new method
        _dismissLoadingSnackbar();
        if (success && mounted) {
          _showSuccessSnackBar('Order #${order.orderId} accepted.');
          await _loadInitialData(); // Refresh lists to move order to Active
           // Optionally switch to the Active tab
           setStateIfMounted(() { // Use setStateIfMounted
             _selectedDeliveryTab = 0;
           });
        } else if (mounted) {
          _showErrorSnackBar('Failed to accept order. It might have been taken.');
          await _loadInitialData(); // Refresh available list
        }
      } catch (e) {
        _dismissLoadingSnackbar();
        print("Failed to accept order: $e");
        if (mounted) _showErrorSnackBar('Failed to accept order: ${e.toString()}');
         await _loadInitialData(); // Refresh available list on error
      }
    }
  }

  Future<void> _handleRejectOrder(Order order) async {
     // Confirmation Dialog
     bool confirm = await showDialog<bool>(
             context: context,
             builder: (BuildContext context) => AlertDialog(
                   title: Text('Reject Order?'),
                   content: Text(
                       'Are you sure you want to reject Order #${order.orderId}? You won\'t see it again.'),
                   actions: <Widget>[
                     TextButton(
                       child: Text('Cancel', style: TextStyle(color: _grey)),
                       onPressed: () => Navigator.of(context).pop(false),
                     ),
                     TextButton(
                       child: Text('Reject', style: TextStyle(color: _red)),
                       onPressed: () => Navigator.of(context).pop(true),
                     ),
                   ],
                 )) ?? false; // Default to false if dialog dismissed

     if (confirm) {
       _showLoadingSnackbar("Rejecting Order #${order.orderId}...");
       try {
         bool success = await TransporterApiService.rejectOrder(order.orderId, widget.transporterId); // Use new method
         _dismissLoadingSnackbar();
         if (success && mounted) {
           _showSuccessSnackBar('Order #${order.orderId} rejected.');
           await _loadInitialData(); // Refresh available list
         } else if (mounted) {
           _showErrorSnackBar('Failed to reject order.');
           await _loadInitialData(); // Refresh list anyway
         }
       } catch (e) {
         _dismissLoadingSnackbar();
         print("Failed to reject order: $e");
         if (mounted) _showErrorSnackBar('Failed to reject order: ${e.toString()}');
         await _loadInitialData(); // Refresh list on error
       }
     }
   }


  // --- Profile Screen ---
  Widget _buildProfileBody() {
     // Show loader only if profile is truly null initially
     if (_isLoadingProfile && _transporterProfile == null) {
        // If there's also a fatal error message, show that instead
       if (_errorMessage != null) return _buildFatalErrorBody(_errorMessage!);
       return Center(child: CircularProgressIndicator(color: _primaryTeal));
     }
     // If profile is loaded (even cached/stale), build the profile screen
     if (_transporterProfile == null) {
        // This case should ideally be covered by the fatal error check, but as a fallback:
        return _buildFatalErrorBody(_profileFetchError ?? "Profile data is unavailable.");
     }


     // Use DefaultTabController for the nested tabs
     return DefaultTabController(
       length: 3, // Number of tabs
       child: NestedScrollView(
         headerSliverBuilder: (BuildContext context, bool innerBoxIsScrolled) {
           // These are the slivers that show above the TabBar
           return <Widget>[
             SliverOverlapAbsorber( // Prevents AppBar shadow overlapping content
               handle: NestedScrollView.sliverOverlapAbsorberHandleFor(context),
               sliver: SliverAppBar(
                 expandedHeight: 280.0, // Adjust as needed for header+stats
                 floating: false,
                 pinned: false, // Header itself doesn't pin
                 backgroundColor: _white,
                 automaticallyImplyLeading: false, // No back button here
                 flexibleSpace: FlexibleSpaceBar(
                    background: Column( // Header + Stats combined
                      children: [
                        _buildProfileHeader(),
                        _buildProfileStats(),
                        SizedBox(height: 8), // Space before tab bar starts
                      ],
                    )
                 ),
               ),
             ),
             SliverPersistentHeader(
               delegate: _SliverAppBarDelegate( // Pinned TabBar
                 TabBar(
                   labelColor: _primaryTeal,
                   unselectedLabelColor: _grey,
                   indicatorColor: _primaryTeal,
                   tabs: [
                     Tab(text: 'Personal'),
                     Tab(text: 'Vehicle'),
                     Tab(text: 'Settings') // Renamed from Preferences
                   ],
                 ),
               ),
               pinned: true,
             ),
           ];
         },
         body: TabBarView( // Content for each tab
            children: [
              _buildPersonalInfoTab(),
              _buildVehicleTab(),
              _buildPreferencesTab(), // Renamed from _buildPreferencesTab
            ],
          ),
       ),
     );
   }


  Widget _buildProfileHeader() {
    // Use loaded profile data
    final profile = _transporterProfile!; // Assumed not null here based on build logic

    return Padding(
      padding: const EdgeInsets.fromLTRB(16.0, 16.0, 16.0, 8.0), // Reduced bottom padding
      child: Column(
        children: [
          GestureDetector(
            onTap: _pickProfileImage,
            child: Stack(
              alignment: Alignment.bottomRight,
              children: [
                CircleAvatar(
                  radius: 50,
                  backgroundColor: _lightTeal,
                  backgroundImage: _profileImageFile != null
                      ? FileImage(_profileImageFile!) as ImageProvider // Show picked file preview
                      : (profile.profileImageUrl != null
                          ? CachedNetworkImageProvider(profile.profileImageUrl!) // Show network image
                          : null), // Show placeholder icon if no image
                   onBackgroundImageError: (_, __) {}, // Handle network image error silently
                  child: (_profileImageFile == null && profile.profileImageUrl == null)
                      ? Icon(Icons.person, size: 60, color: _primaryTeal) // Placeholder Icon
                      : null,
                ),
                 // Loading indicator during upload
                 if (_isUploadingProfileImage)
                  Positioned.fill(
                    child: Container(
                      decoration: BoxDecoration(
                         color: Colors.black.withOpacity(0.3),
                         shape: BoxShape.circle,
                       ),
                      child: Center(child: CircularProgressIndicator(color: _white, strokeWidth: 2)),
                    ),
                  ),
                 // Edit Icon
                 if (!_isUploadingProfileImage)
                  Container(
                    padding: EdgeInsets.all(4),
                    decoration: BoxDecoration(
                        color: _primaryTeal,
                        shape: BoxShape.circle,
                        border: Border.all(color: _white, width: 1.5)),
                    child: Icon(Icons.edit, color: _white, size: 16),
                  )
              ],
            ),
          ),
          SizedBox(height: 12),
          Text(profile.name,
              style: TextStyle(fontSize: 22, fontWeight: FontWeight.bold, color: _darkTeal)),
          SizedBox(height: 4),
          // Row for Vehicle Type and Rating Chips
          Row(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              if (profile.vehicleType != null && profile.vehicleType!.isNotEmpty)
                 Chip(
                    label: Text(profile.vehicleType!, style: TextStyle(fontSize: 12, color: _darkTeal)),
                    backgroundColor: _primaryTeal.withOpacity(0.1),
                    padding: EdgeInsets.symmetric(horizontal: 8, vertical: 2),
                    visualDensity: VisualDensity(horizontal: 0.0, vertical: -4), // Makes chip smaller
                    side: BorderSide.none
                  ),
              if (profile.vehicleType != null && profile.vehicleType!.isNotEmpty && profile.rating != null)
                 SizedBox(width: 8), // Spacer only if both exist
              if (profile.rating != null)
                 Container( // Rating Chip Style
                    padding: EdgeInsets.symmetric(horizontal: 8, vertical: 4),
                    decoration: BoxDecoration(
                      color: _lightTeal.withOpacity(0.5),
                      borderRadius: BorderRadius.circular(12)
                    ),
                   child: Row(
                     mainAxisSize: MainAxisSize.min,
                     children: [
                       Icon(Icons.star, color: Colors.amber, size: 16),
                       SizedBox(width: 4),
                       Text(profile.rating!.toStringAsFixed(1),
                           style: TextStyle(color: _darkTeal, fontWeight: FontWeight.bold, fontSize: 12)),
                     ]
                   )
                  ),
            ]
          ),
          // Removed redundant Log Out button, moved Sign Out to drawer
        ],
      ),
    );
  }


  Widget _buildProfileStats() {
    // Calculate stats based on loaded data
     int totalDeliveries = _getCompletedOrdersOnly().length; // Only count fully completed
     double acceptanceRate = 95.0; // Placeholder - Needs backend data
     double totalEarnings = _payments
         .where((p) => p.disbursementTransactionStatus.toLowerCase() == 'successful')
         .fold(0.0, (sum, p) => sum + p.amount); // Sum successful payments

     return Card(
       margin: EdgeInsets.symmetric(horizontal: 16, vertical: 8),
       elevation: 1,
       shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
       child: Padding(
         padding: const EdgeInsets.symmetric(horizontal: 16.0, vertical: 12.0), // Adjusted padding
         child: Column( // Removed unnecessary inner column
           crossAxisAlignment: CrossAxisAlignment.start,
           children: [
             Row( // Two rows of two stats each
               mainAxisAlignment: MainAxisAlignment.spaceAround,
               children: [
                 _buildStatItem(Icons.motorcycle, totalDeliveries.toString(), 'Completed'),
                 _buildStatItem(Icons.star_border, _transporterProfile?.rating?.toStringAsFixed(1) ?? 'N/A', 'Rating'),
               ]
             ),
             SizedBox(height: 16), // Spacer between rows
             Row(
                mainAxisAlignment: MainAxisAlignment.spaceAround,
                children: [
                  _buildStatItem(Icons.thumb_up_alt_outlined, '${acceptanceRate.toStringAsFixed(0)}%', 'Acceptance', color: _primaryTeal), // Example stat
                 _buildStatItem(Icons.account_balance_wallet_outlined, '\$${totalEarnings.toStringAsFixed(0)}', 'Total Earned', color: _green),
               ]
             ),
           ]
         ),
       ),
     );
   }

  Widget _buildStatItem(IconData icon, String value, String label, {Color color = _primaryTeal}) {
     return Column(
       children: [
         Container(
           padding: EdgeInsets.all(8), // Smaller padding
           decoration: BoxDecoration(
             color: color.withOpacity(0.1),
             shape: BoxShape.circle,
           ),
           child: Icon(icon, color: color, size: 20), // Smaller icon
         ),
         SizedBox(height: 6), // Reduced space
         Text(value, style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold, color: _darkTeal)), // Smaller value text
         Text(label, style: TextStyle(fontSize: 11, color: _grey)), // Smaller label text
       ]
     );
   }


