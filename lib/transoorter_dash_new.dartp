   }


  Widget _buildStatusTimelineCard() {
     // Determine which statuses are met
     bool acceptedMet = _isStatusMet([Order.STATUS_RIDER_ACCEPTED, Order.STATUS_PICKED_UP, Order.STATUS_ON_THE_WAY, Order.STATUS_DELIVERED, Order.STATUS_COMPLETED]);
     bool pickedUpMet = _isStatusMet([Order.STATUS_PICKED_UP, Order.STATUS_ON_THE_WAY, Order.STATUS_DELIVERED, Order.STATUS_COMPLETED]);
     bool onTheWayMet = _isStatusMet([Order.STATUS_ON_THE_WAY, Order.STATUS_DELIVERED, Order.STATUS_COMPLETED]);
     bool deliveredMet = _isStatusMet([Order.STATUS_DELIVERED, Order.STATUS_COMPLETED]);
     bool completedMet = _isStatusMet([Order.STATUS_COMPLETED]);

     return Card(
         elevation: 1,
         shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
         child: Padding(
             padding: EdgeInsets.all(16.0),
             child: Column(
                 crossAxisAlignment: CrossAxisAlignment.start,
                 children: [
                   Text('Status Timeline', style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold, color: _darkTeal)),
                   SizedBox(height: 16),
                   _buildStatusItem('Accepted', 'You accepted the order', acceptedMet),
                   _buildStatusItem('Picked Up', 'Order collected from pickup', pickedUpMet),
                   _buildStatusItem('On The Way', 'Delivery in progress', onTheWayMet),
                   _buildStatusItem('Arrived / Verify', _getDeliveredSubtitle(), deliveredMet, needsVerification: _needsVerification() && !completedMet),
                   _buildStatusItem('Completed', 'Delivery verified & finished', completedMet, isLast: true),
                 ])));
   }


  Widget _buildStatusItem(String title, String subtitle, bool isCompleted, {bool isLast = false, bool needsVerification = false}) {
     IconData iconData;
     Color iconColor;
     Color textColor;

     if (isCompleted) {
       iconData = Icons.check_circle;
       iconColor = _green;
       textColor = _darkTeal;
     } else if (needsVerification && _currentOrder.orderStatus == Order.STATUS_DELIVERED) {
        // Special state: Arrived but needs code
        iconData = Icons.pin_drop; // Use a location pin icon
        iconColor = _orange; // Use orange for pending verification
        textColor = _orange;
     }
      else {
       iconData = Icons.radio_button_unchecked;
       iconColor = Colors.grey[400]!; // Fix: Use grey[400]!
       textColor = _grey;
     }

     // Line color depends on completion of *this* step
     Color lineColor = isCompleted ? _green : Colors.grey[300]!; // Fix: Use grey[300]!

     return Row(
       crossAxisAlignment: CrossAxisAlignment.start,
       children: [
         Column( // Icon and Line column
           children: [
             Icon(iconData, color: iconColor, size: 24),
             if (!isLast)
               Container(
                   width: 1.5, // Slightly thicker line
                   height: 30,
                   color: lineColor, // Line color based on this step's completion
                   margin: EdgeInsets.symmetric(vertical: 4))
           ]
         ),
         SizedBox(width: 12),
         Expanded( // Text column
           child: Padding(
             padding: const EdgeInsets.only(top: 2.0, bottom: 16.0), // Adjust padding for alignment
             child: Column(
               crossAxisAlignment: CrossAxisAlignment.start,
               children: [
                 Text(title, style: TextStyle(fontSize: 15, fontWeight: FontWeight.w600, color: textColor)),
                 Text(subtitle, style: TextStyle(fontSize: 13, color: _grey)), // Subtitle always grey
               ]
             )
           )
         ),
       ]
     );
   }

  // Checks if the current order status is one of the target statuses or beyond
  bool _isStatusMet(List<String> targetStatuses) {
     // Define the order sequence
     const statusOrder = [
        Order.STATUS_PENDING, Order.STATUS_ASSIGNED, Order.STATUS_RIDER_ACCEPTED,
        Order.STATUS_PICKED_UP, Order.STATUS_ON_THE_WAY, Order.STATUS_DELIVERED,
        Order.STATUS_COMPLETED
     ];
     // Find the index of the current status
     int currentIndex = statusOrder.indexOf(_currentOrder.orderStatus);
     // Find the minimum index required by targetStatuses
     int requiredIndex = -1;
      for(String target in targetStatuses) {
         int idx = statusOrder.indexOf(target);
         if (idx != -1) {
            requiredIndex = (requiredIndex == -1) ? idx : ((idx < requiredIndex) ? idx : requiredIndex);
         }
      }
     // If current status index is >= required index, the status is met or surpassed
     return currentIndex != -1 && requiredIndex != -1 && currentIndex >= requiredIndex;
  }

  // Get subtitle text for the "Delivered" status item
  String _getDeliveredSubtitle() {
    if (_isStatusMet([Order.STATUS_COMPLETED])) return 'Delivery successfully completed';
    if (_isStatusMet([Order.STATUS_DELIVERED])) return 'Awaiting verification code';
    return 'Pending arrival'; // Default if not yet delivered
  }

  // Verification Card (shown when status is delivered)
  Widget _buildDeliveryVerificationCard() {
    return Card(
        elevation: 1,
        color: _orange.withOpacity(0.05), // Slight orange background
        shape: RoundedRectangleBorder(
            borderRadius: BorderRadius.circular(12),
             side: BorderSide(color: _orange.withOpacity(0.5)) // Orange border
        ),
        child: Padding(
            padding: EdgeInsets.all(16.0),
            child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text('Delivery Verification', style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold, color: _darkTeal)),
                  SizedBox(height: 8),
                  Text('Ask the customer for their 6-digit verification code to complete the delivery.', style: TextStyle(color: _grey, fontSize: 14)),
                  SizedBox(height: 16),
                  // Code Input Field
                  TextField(
                    controller: _verificationCodeController,
                    keyboardType: TextInputType.number,
                    maxLength: 6,
                    textAlign: TextAlign.center,
                    inputFormatters: [FilteringTextInputFormatter.digitsOnly], // Ensure only digits
                    style: TextStyle(fontSize: 24, fontWeight: FontWeight.bold, letterSpacing: 8, color: _darkTeal),
                    decoration: InputDecoration(
                      hintText: '______',
                      hintStyle: TextStyle(color: Colors.grey[400], fontSize: 24, letterSpacing: 8), // Fix: Use grey[400]
                      counterText: "", // Hide the counter
                      filled: true,
                      fillColor: _white, // White background for input
                      border: OutlineInputBorder(borderRadius: BorderRadius.circular(8.0), borderSide: BorderSide(color: Colors.grey[300]!)), // Fix: Use grey[300]!
                      focusedBorder: OutlineInputBorder(borderRadius: BorderRadius.circular(8.0), borderSide: BorderSide(color: _primaryTeal)),
                      contentPadding: EdgeInsets.symmetric(vertical: 14),
                    ),
                  ),
                  SizedBox(height: 16),
                  // Verify Button
                  SizedBox(
                    width: double.infinity,
                    child: ElevatedButton(
                      onPressed: _isUpdatingStatus ? null : _handleVerifyCode, // Call verify handler
                      child: _isUpdatingStatus
                          ? SizedBox(height: 20, width: 20, child: CircularProgressIndicator(strokeWidth: 2, color: _white))
                          : Text('Verify & Complete Delivery'),
                      style: ElevatedButton.styleFrom(
                          backgroundColor: _green, // Use Green for final confirmation
                          foregroundColor: _white,
                          padding: EdgeInsets.symmetric(vertical: 12),
                          shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(8))),
                    ),
                  ),
                ])));
  }

   // Helper method to update state safely
   void setStateIfMounted(VoidCallback fn) {
     if (mounted) {
       setState(fn);
     }
   }

   // SnackBar helpers (local to this screen)
   void _showSnackBar(String m, {bool isError = false, int d = 3}) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).removeCurrentSnackBar();
      ScaffoldMessenger.of(context).showSnackBar(SnackBar(
        content: Text(m, style: TextStyle(color: _white), textAlign: TextAlign.center),
        backgroundColor: isError ? _errorColor.withOpacity(0.9) : _darkTeal.withOpacity(0.9),
        duration: Duration(seconds: d),
        behavior: SnackBarBehavior.floating,
        margin: const EdgeInsets.fromLTRB(15.0, 5.0, 15.0, 10.0), // Adjust margins
        padding: const EdgeInsets.symmetric(vertical: 12.0, horizontal: 15.0),
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(10.0)),
        elevation: 4.0,
      ));
    }
   void _showErrorSnackBar(String message) => _showSnackBar(message, isError: true, d: 4);
   void _showSuccessSnackBar(String message) => _showSnackBar(message, isError: false);
   void _showLoadingSnackbar(String message) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).removeCurrentSnackBar();
      ScaffoldMessenger.of(context).showSnackBar(SnackBar(
        content: Row(mainAxisAlignment: MainAxisAlignment.center, children: [
          const SizedBox(width: 16, height: 16, child: CircularProgressIndicator(strokeWidth: 2, color: Colors.white)),
          const SizedBox(width: 12),
          Text(message, style: const TextStyle(color: Colors.white))
        ]),
        backgroundColor: Colors.black.withOpacity(0.7),
        duration: const Duration(seconds: 60),
        behavior: SnackBarBehavior.floating,
        margin: const EdgeInsets.fromLTRB(50.0, 5.0, 50.0, 10.0), // Adjust margins
        padding: const EdgeInsets.symmetric(vertical: 10.0, horizontal: 15.0),
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(20.0)),
      ));
    }
   void _dismissLoadingSnackbar() {
      if (mounted) ScaffoldMessenger.of(context).removeCurrentSnackBar();
    }

} // End OrderDetailsScreen

// ================================================
// === EARNINGS HISTORY SCREEN ====================
// ================================================
class EarningsHistoryScreen extends StatelessWidget {
  final List<Payment> payments;
  const EarningsHistoryScreen({Key? key, required this.payments}) : super(key: key);

  @override
  Widget build(BuildContext context) {
    // Group payments by date (day only)
    Map<DateTime, List<Payment>> groupedPayments = {};
    for (var payment in payments) {
      DateTime dateKey = DateTime(payment.createdAt.year, payment.createdAt.month, payment.createdAt.day);
      groupedPayments.putIfAbsent(dateKey, () => []).add(payment);
    }
    // Sort dates descending (most recent first)
    List<DateTime> sortedDates = groupedPayments.keys.toList()
      ..sort((a, b) => b.compareTo(a));

    return Scaffold(
      backgroundColor: _white,
      appBar: AppBar(
        title: Text('Earnings History', style: TextStyle(color: _darkTeal, fontWeight: FontWeight.bold)),
        backgroundColor: _white,
        foregroundColor: _darkTeal,
        elevation: 1,
        leading: IconButton(
            icon: Icon(Icons.arrow_back, color: _darkTeal),
            onPressed: () => Navigator.of(context).pop()),
      ),
      body: payments.isEmpty
          ? Center(child: Text('No payment history found.', style: TextStyle(color: _grey)))
          : ListView.builder(
              itemCount: sortedDates.length,
              padding: EdgeInsets.all(16),
              itemBuilder: (context, index) {
                DateTime date = sortedDates[index];
                List<Payment> dailyPayments = groupedPayments[date]!;
                // Calculate daily total only from successful payments
                double dailyTotal = dailyPayments
                    .where((p)=> p.disbursementTransactionStatus.toLowerCase() == 'successful')
                    .fold(0.0, (sum, p) => sum + p.amount);
                String formattedDate = DateFormat('EEEE, MMM d, yyyy').format(date);

                return Padding(
                  padding: const EdgeInsets.only(bottom: 16.0),
                  child: Card(
                      elevation: 1,
                      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
                      child: Padding(
                          padding: const EdgeInsets.all(16.0),
                          child: Column(
                              crossAxisAlignment: CrossAxisAlignment.start,
                              children: [
                                // Date Header Row
                                Row(
                                    mainAxisAlignment: MainAxisAlignment.spaceBetween,
                                    children: [
                                      Text(formattedDate, style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold, color: _darkTeal)),
                                      Text('\$${dailyTotal.toStringAsFixed(2)}', style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold, color: _green)),
                                    ]),
                                Divider(height: 20, color: _lightTeal.withOpacity(0.6)),
                                // List of payments for that day
                                ...dailyPayments.map((payment) => _buildPaymentItem(payment)).toList(),
                              ]))),
                );
              }),
    );
  }

  Widget _buildPaymentItem(Payment payment) {
    Color statusColor;
    IconData statusIcon;
    String statusText = payment.disbursementTransactionStatus; // Show the disbursement status

    switch (statusText.toLowerCase()) {
      case 'successful':
        statusColor = _green;
        statusIcon = Icons.check_circle;
        break;
      case 'pending':
        statusColor = _grey;
        statusIcon = Icons.hourglass_empty;
        break;
      case 'in progress':
         statusColor = Colors.orange;
         statusIcon = Icons.sync;
         statusText = 'Processing'; // Make it clearer
         break;
      case 'failed':
        statusColor = _red;
        statusIcon = Icons.error;
        break;
      default:
        statusColor = _grey;
        statusIcon = Icons.help_outline;
    }

    return Padding(
        padding: const EdgeInsets.symmetric(vertical: 8.0),
        child: Row(
            children: [
              Icon(Icons.receipt_long_outlined, color: _primaryTeal, size: 20),
              SizedBox(width: 12),
              Expanded( // Order Info
                  child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        Text('Order #${payment.orderId} (${payment.orderType})', style: TextStyle(fontWeight: FontWeight.w600)),
                        // Optional: Show order transaction status if different/useful
                        // Text('Order: ${payment.orderTransactionStatus}', style: TextStyle(color: _grey, fontSize: 12)),
                         Text(DateFormat('h:mm a').format(payment.createdAt), style: TextStyle(color: _grey, fontSize: 12)), // Show time
                      ])),
              SizedBox(width: 8),
              Column( // Amount and Status
                  crossAxisAlignment: CrossAxisAlignment.end,
                  children: [
                    Text('\$${payment.amount.toStringAsFixed(2)}', style: TextStyle(fontWeight: FontWeight.bold, color: _darkTeal)),
                    Row(children: [
                      Icon(statusIcon, size: 12, color: statusColor),
                      SizedBox(width: 4),
                      Text(statusText, style: TextStyle(color: statusColor, fontSize: 11)),
                    ]),
                  ]),
            ]));
  }
}
