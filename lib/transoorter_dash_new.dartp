    }
  }

  // UPDATE: Centralized status update method
  static Future<bool> _updateOrderStatus(
      int orderId, String newStatus, String transporterId,
      {String? endpointPath}) async {
    final Uri uri =
        Uri.parse('$apibaseurl/rr/orders/$orderId/${endpointPath ?? 'status'}');
    print(
        "Updating order $orderId status to $newStatus (Transporter: $transporterId) via $uri");

    Map<String, dynamic> body = {
      'order_status': newStatus,
      // Only include transporter_id if endpoint requires it explicitly (like accept/reject might)
      if (newStatus == Order.STATUS_RIDER_ACCEPTED || newStatus == Order.STATUS_RIDER_REJECTED)
         'transporter_id': int.tryParse(transporterId),
    };
    // Clean nulls from body if API doesn't like them
    body.removeWhere((key, value) => value == null);

    try {
      final response = await http.patch(
        uri,
        headers: _getWriteHeaders(requiresAuth: true),
        body: jsonEncode(body),
      );
      if (response.statusCode == 200 || response.statusCode == 204) {
        print("Order $orderId status updated to $newStatus successfully.");
        return true;
      } else {
        print(
            "Error updating order status: ${response.statusCode} ${response.body}");
        String errorMessage = 'Failed to update status to $newStatus.';
        try {
          final errorBody = json.decode(response.body);
          errorMessage =
              errorBody['message'] ?? errorBody['error'] ?? errorMessage;
        } catch (_) {}
        throw Exception(
            'Failed to update order status (Code: ${response.statusCode}) - $errorMessage');
      }
    } catch (e) {
      print("Exception updating order status to $newStatus: $e");
      throw Exception('Failed to update order status: ${e.toString()}');
    }
  }

  // NEW: Accept an available order
  static Future<bool> acceptOrder(int orderId, String transporterId) async {
    // Calls the central update method with specific status
    // Assuming the endpoint for accept requires transporter_id
    return await _updateOrderStatus(
        orderId, Order.STATUS_RIDER_ACCEPTED, transporterId, endpointPath: 'status'); // Assuming endpoint is /status
  }

  // NEW: Reject an available order
  static Future<bool> rejectOrder(int orderId, String transporterId) async {
    // Calls the central update method with specific status
    // Assuming the endpoint for reject requires transporter_id
    return await _updateOrderStatus(
        orderId, Order.STATUS_RIDER_REJECTED, transporterId, endpointPath: 'status'); // Assuming endpoint is /status
  }

  // UPDATE: General status update (e.g., picked_up, on_the_way)
  static Future<bool> updateOrderStatusByTransporter(
      int orderId, String newStatus, String transporterId) async {
    // This specific method might not need transporterId in the body,
    // using the _updateOrderStatus helper handles this implicitly if needed
    return await _updateOrderStatus(orderId, newStatus, transporterId, endpointPath: 'status');
  }

  // NEW: Verify Delivery Code and Complete Order
  // Returns true on success, throws Exception on failure
  static Future<bool> verifyDeliveryCode(
      int orderId, String verificationCode) async {
    final Uri uri = Uri.parse('$apibaseurl/rr/rc'); // Rider Complete endpoint
    print("Verifying code for order $orderId via $uri");

    try {
      final response = await http.post(
        // Assuming POST for this action
        uri,
        headers: _getWriteHeaders(requiresAuth: true),
        body: jsonEncode({
          'order_id': orderId,
          'verification_code': verificationCode,
        }),
      );

      if (response.statusCode == 200) {
        final dynamic responseData = json.decode(response.body);
        // Check for specific success message
        final String message =
            getStringSafe(responseData['message'] ?? responseData['msg'])
                    ?.toLowerCase() ??
                '';
        if (message.contains("delivery completed") ||
            message.contains("success")) {
          print(
              "Verification successful for order $orderId. Response: ${response.body}");
          return true;
        } else {
          // Got 200 OK but message indicates failure (e.g., wrong code)
          print(
              "Verification failed for order $orderId (API Message): $message");
          throw Exception(
              getStringSafe(responseData['message'] ?? responseData['error']) ??
                  'Verification failed');
        }
      } else {
        // Handle non-200 status codes (e.g., 400 Bad Request for wrong code)
        print("Error verifying code: ${response.statusCode} ${response.body}");
        String errorMessage = 'Verification failed.';
        try {
          final errorBody = json.decode(response.body);
          errorMessage =
              errorBody['message'] ?? errorBody['error'] ?? errorMessage;
        } catch (_) {}
        // Customize error for wrong code if API provides specific status/message
        if (response.statusCode == 400 ||
            errorMessage.toLowerCase().contains("wrong code")) {
          throw Exception('Wrong verification code.');
        }
        throw Exception(
            'Verification failed (Code: ${response.statusCode}) - $errorMessage');
      }
    } catch (e) {
      print("Exception verifying code: $e");
      // Rethrow specific exceptions or wrap
      if (e is Exception) {
        throw e;
      }
      throw Exception('Failed to verify code: ${e.toString()}');
    }
  }

  static Future<bool> updateTransporterActiveStatus(
      String transporterId, bool isActive) async {
    if (transporterId.isEmpty) {
       throw Exception('Transporter ID provided is empty.');
     }
