    return Card(
      elevation: 1,
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
      child: Padding(
        padding: EdgeInsets.all(16.0),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text('Recent Activity',
                style: TextStyle(
                    fontSize: 18,
                    fontWeight: FontWeight.bold,
                    color: _darkTeal)),
            Text('Your latest completed or ended deliveries', // Updated subtitle
                style: TextStyle(color: _grey, fontSize: 14)),
            SizedBox(height: 16),
            if (recentOrders.isEmpty)
              Text('No recent activity.', style: TextStyle(color: _grey))
            else
              Column(
                children: [
                  ...recentOrders.map((order) => _buildRecentActivityItem(order)),
                  Padding(
                    padding: const EdgeInsets.only(top: 12.0),
                    child: Align(
                      alignment: Alignment.centerRight,
                      child: InkWell(
                        onTap: () {
                          setState(() {
                            _selectedDrawerIndex = 1;
                            _selectedDeliveryTab = 2; // Go to Completed tab
                          });
                        },
                        child: Text(
                          'View full history',
                          style: TextStyle(
                              color: _primaryTeal, fontWeight: FontWeight.w600),
                        ),
                      ),
                    ),
                  )
                ],
              ),
          ],
        ),
      ),
    );
  }


  Widget _buildRecentActivityItem(Order order) {
    IconData statusIcon;
    Color iconColor;
    String relativeTime = _getRelativeTime(order.orderDate); // How long ago it finished/cancelled

    switch (order.orderStatus.toLowerCase()) {
      case Order.STATUS_COMPLETED:
      case Order.STATUS_DELIVERED: // Consider delivered as success here
        statusIcon = Icons.check_circle;
        iconColor = _green;
        break;
      case Order.STATUS_CANCELLED:
      case Order.STATUS_RIDER_REJECTED:
        statusIcon = Icons.cancel;
        iconColor = _red;
        break;
      default: // Should not happen in recent activity based on filter
        statusIcon = Icons.help_outline;
        iconColor = _grey;
        relativeTime = "Unknown";
        break;
    }

    IconData leadingIcon = order.orderType.toLowerCase() == 'meal'
        ? Icons.restaurant_menu // Use restaurant_menu for meals
        : Icons.inventory_2; // Use inventory for produce/other

    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 8.0),
      child: Row(
        children: [
          Container(
            padding: EdgeInsets.all(8),
            decoration: BoxDecoration(
              color: _primaryTeal.withOpacity(0.1),
              shape: BoxShape.circle,
            ),
            child: Icon(leadingIcon, color: _primaryTeal, size: 20),
          ),
          SizedBox(width: 12),
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text('Order #${order.orderId}',
                    style: TextStyle(
                        fontWeight: FontWeight.w600, color: _darkTeal)),
                Text(_getStatusText(order.orderStatus), // User-friendly status
                    style: TextStyle(color: _grey, fontSize: 13)),
              ],
            ),
          ),
          SizedBox(width: 8),
          Column(
            crossAxisAlignment: CrossAxisAlignment.end,
            children: [
              Text(relativeTime, style: TextStyle(color: _grey, fontSize: 12)),
              SizedBox(height: 2),
              Icon(statusIcon, color: iconColor, size: 16),
            ],
          ),
        ],
      ),
    );
  }

  String _getRelativeTime(DateTime dateTime) {
    final Duration difference = DateTime.now().difference(dateTime);

    if (difference.inSeconds < 60) return '${difference.inSeconds}s ago';
    if (difference.inMinutes < 60) return '${difference.inMinutes}m ago';
    if (difference.inHours < 24) return '${difference.inHours}h ago';
    if (difference.inDays < 2) return 'Yesterday';
    if (difference.inDays < 7) return '${difference.inDays}d ago';
    // For older dates, show month and day
    return DateFormat('MMM d').format(dateTime);
  }


  String _getStatusText(String apiStatus) {
    switch (apiStatus.toLowerCase()) {
      case Order.STATUS_PENDING: return 'Pending';
      case Order.STATUS_ASSIGNED: return 'Assigned';
      case Order.STATUS_RIDER_ACCEPTED: return 'Accepted'; // Use new status
      case Order.STATUS_PICKED_UP: return 'Picked Up';
      case Order.STATUS_ON_THE_WAY: return 'On The Way';
      case Order.STATUS_DELIVERING: return 'Delivering'; // Keep if used by backend sometimes
      case Order.STATUS_DELIVERED: return 'Arrived / Verify'; // Adjusted text
      case Order.STATUS_COMPLETED: return 'Completed';
      case Order.STATUS_CANCELLED: return 'Cancelled';
      case Order.STATUS_RIDER_REJECTED: return 'Rejected'; // Use new status
      case 'available': return 'Available'; // Handle alternative status text
      default: return apiStatus.replaceAll('_', ' ').split(' ').map((word) => word[0].toUpperCase() + word.substring(1)).join(' '); // Fallback formatting
    }
  }


  Widget _buildScheduledDeliveriesCard(List<Order> scheduledOrders) {
     return Card(
       elevation: 1,
       shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
       child: Padding(
         padding: EdgeInsets.all(16.0),
         child: Column(
           crossAxisAlignment: CrossAxisAlignment.start,
           children: [
             Text('Next Accepted Deliveries', // Updated title
                 style: TextStyle(
                     fontSize: 18,
                     fontWeight: FontWeight.bold,
                     color: _darkTeal)),
             Text('Upcoming orders you have accepted', // Updated subtitle
                 style: TextStyle(color: _grey, fontSize: 14)),
             SizedBox(height: 16),
             if (scheduledOrders.isEmpty)
               Text('No scheduled deliveries found.', style: TextStyle(color: _grey))
             else
               Column(
                 // Take only the next 2-3 scheduled deliveries for the dashboard card
                 children: scheduledOrders.take(3).map(_buildScheduledDeliveryItem).toList(),
               ),
             if (scheduledOrders.length > 3)
                Padding(
                 padding: const EdgeInsets.only(top: 12.0),
                 child: Align(
                   alignment: Alignment.centerRight,
                   child: InkWell(
                     onTap: () {
                       setState(() {
                         _selectedDrawerIndex = 1;
                         _selectedDeliveryTab = 0; // Go to Active tab
                       });
                     },
                     child: Text(
                       'View all active',
                       style: TextStyle(
                           color: _primaryTeal, fontWeight: FontWeight.w600),
                     ),
                   ),
                 ),
               )
           ],
         ),
       ),
     );
   }

  Widget _buildScheduledDeliveryItem(Order order) {
    // Format time based on how far in the future it is
    String formattedTime;
    DateTime now = DateTime.now();
    DateTime orderTime = order.orderDate;
    if (orderTime.year == now.year && orderTime.month == now.month && orderTime.day == now.day) {
      // Today
      formattedTime = DateFormat('h:mm a').format(orderTime);
    } else if (orderTime.year == now.year && orderTime.month == now.month && orderTime.day == now.day + 1) {
      // Tomorrow
      formattedTime = 'Tomorrow, ${DateFormat('h:mm a').format(orderTime)}';
    } else {
      // Other days
      formattedTime = DateFormat('MMM d, h:mm a').format(orderTime);
    }

    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 12.0),
      child: InkWell( // Make item tappable to go to details
        onTap: () => _navigateToOrderDetails(order),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              mainAxisAlignment: MainAxisAlignment.spaceBetween,
              children: [
                Expanded( // Allow title to wrap if needed
                  child: Text(
                    order.productName ?? order.mealName ?? 'Order #${order.orderId}',
                    style: TextStyle(
                        fontWeight: FontWeight.w600, color: _darkTeal, fontSize: 15),
                    overflow: TextOverflow.ellipsis,
                  ),
                ),
                SizedBox(width: 8), // Spacing
                Row( // Time chip
                  children: [
                    Icon(Icons.access_time, size: 14, color: _grey),
                    SizedBox(width: 4),
                    Text(formattedTime, style: TextStyle(color: _grey, fontSize: 13)),
                  ]
                ),
              ]
            ),
            SizedBox(height: 6),
            Row( // Delivery Address
              children: [
                Icon(Icons.location_on_outlined, size: 14, color: _grey),
                SizedBox(width: 4),
                Expanded(
                    child: Text(order.simplifiedDeliveryAddress,
                        style: TextStyle(color: _grey, fontSize: 13),
                        overflow: TextOverflow.ellipsis,
                        maxLines: 1))
              ]
            ),
            SizedBox(height: 8),
            Row( // Distance and Earnings
              mainAxisAlignment: MainAxisAlignment.spaceBetween,
              children: [
                Text('Dist: ${order.estimatedDistance}', style: TextStyle(color: _grey, fontSize: 13)),
                Text(
                    '\$${order.earnings.toStringAsFixed(2)}',
                    style: TextStyle(color: _green, fontWeight: FontWeight.bold, fontSize: 14)
                ),
              ]
            ),
             Divider(color: _lightTeal.withOpacity(0.5), height: 20), // Separator
          ],
        ),
      )
    );
  }

  // --- Deliveries Screen ---
  Widget _buildDeliveriesBody() {
     List<Order> ordersToShow;
     String tabTitle;

     switch (_selectedDeliveryTab) {
       case 0:
         ordersToShow = _getActiveOrders();
         tabTitle = 'Active';
         break;
       case 1:
         ordersToShow = _getAvailableOrders();
         tabTitle = 'Available';
         break;
       case 2:
         ordersToShow = _getCompletedOrders();
         tabTitle = 'Completed';
         break;
       default:
         ordersToShow = [];
         tabTitle = '';
     }

     return Column(
       children: [
         // Tabs
         Padding(
           padding: const EdgeInsets.symmetric(vertical: 8.0, horizontal: 16.0),
           child: _buildDeliveryTabs(),
         ),
         // Orders List
         Expanded(
           child: RefreshIndicator(
             onRefresh: _loadInitialData, // Refresh fetches all data again
             color: _primaryTeal,
             child: ordersToShow.isEmpty
                 ? Center(
                     child: Text(
                         'No $tabTitle deliveries found.',
                         style: TextStyle(color: _grey, fontSize: 16)))
                 : ListView.builder(
                     itemCount: ordersToShow.length,
                     padding: EdgeInsets.only(left: 16, right: 16, bottom: 16, top: 8),
                     itemBuilder: (context, index) {
                       return Padding(
                         padding: const EdgeInsets.only(bottom: 12.0),
                         child: _buildOrderCard(ordersToShow[index]),
                       );
                     },
                   ),
           ),
         ),
       ],
     );
   }

  Widget _buildDeliveryTabs() {
     return Container(
       decoration: BoxDecoration(
           color: _lightGrey, borderRadius: BorderRadius.circular(30)),
       padding: EdgeInsets.all(4),
       child: Row(
         children: [
           _buildTabItem('Active', 0),
           _buildTabItem('Available', 1),
           _buildTabItem('Completed', 2),
         ],
       ),
     );
   }

  Widget _buildTabItem(String title, int index) {
     bool isSelected = _selectedDeliveryTab == index;
     return Expanded(
       child: GestureDetector(
         onTap: () {
           if (_selectedDeliveryTab != index) {
             setState(() {
               _selectedDeliveryTab = index;
             });
           }
         },
         child: Container(
           padding: EdgeInsets.symmetric(vertical: 10),
           decoration: BoxDecoration(
             color: isSelected ? _white : Colors.transparent,
             borderRadius: BorderRadius.circular(30),
             boxShadow: isSelected
                 ? [
                     BoxShadow(
                         color: Colors.grey.withOpacity(0.2),
                         spreadRadius: 1,
                         blurRadius: 3,
                         offset: Offset(0, 1))
                   ]
                 : [],
           ),
           child: Text(title,
               textAlign: TextAlign.center,
               style: TextStyle(
                   color: isSelected ? _primaryTeal : _grey,
                   fontWeight:
                       isSelected ? FontWeight.bold : FontWeight.normal)),
         ),
       ),
     );
   }


  List<Order> _getActiveOrders() {
    // Includes accepted, picked up, on the way, delivered (but not completed)
    const activeStatuses = {
      Order.STATUS_RIDER_ACCEPTED,
      Order.STATUS_PICKED_UP,
      Order.STATUS_ON_THE_WAY,
      Order.STATUS_DELIVERING, // Keep if backend uses it
      Order.STATUS_ASSIGNED,    // If assigned means active for this user
      Order.STATUS_DELIVERED,   // Delivered is active until completed
    };
    return _allOrders
        .where((o) => activeStatuses.contains(o.orderStatus))
        .toList()
      ..sort((a, b) => a.orderDate.compareTo(b.orderDate)); // Sort chronologically (next up first)
  }

  List<Order> _getAvailableOrders() {
    // Only pending/available status
    const availableStatuses = {Order.STATUS_PENDING, 'available'};
    return _allOrders
        .where((o) => availableStatuses.contains(o.orderStatus.toLowerCase()))
        .toList()
      ..sort((a, b) => b.orderDate.compareTo(a.orderDate)); // Sort newest first
  }

  List<Order> _getCompletedOrders() {
    // Includes completed, cancelled, rejected
    const completedStatuses = {
      Order.STATUS_COMPLETED,
      Order.STATUS_CANCELLED,
      Order.STATUS_RIDER_REJECTED,
    };
    return _allOrders
        .where((o) => completedStatuses.contains(o.orderStatus))
        .toList()
      ..sort((a, b) => b.orderDate.compareTo(a.orderDate)); // Sort most recent first
  }

  // Removed _getTabName as it's not used

  Widget _buildOrderCard(Order order) {
    String status = order.orderStatus;
    bool isAvailable = _selectedDeliveryTab == 1; // Check based on current tab
    bool isCompletedOrRejected = _selectedDeliveryTab == 2;
    bool isActive = _selectedDeliveryTab == 0;

    Color statusColor;
    String statusText = _getStatusText(status);
    Widget? actionButton;

    // Determine Status Color based on actual status, not tab
    if (status == Order.STATUS_COMPLETED) statusColor = _green;
    else if (status == Order.STATUS_CANCELLED || status == Order.STATUS_RIDER_REJECTED) statusColor = _red;
    else if (status == Order.STATUS_PENDING || status == 'available') statusColor = _orange;
    else if (status == Order.STATUS_DELIVERED) statusColor = _orange; // Orange for arrived/verify
    else statusColor = _primaryTeal; // Default for other active statuses


    // Determine Action Button based on current tab/status
    if (isAvailable) {
      // Available Tab: Accept/Reject buttons
      actionButton = Row(children: [
        Expanded(
            child: OutlinedButton(
          onPressed: () => _handleRejectOrder(order),
          child: Text('Reject'),
          style: OutlinedButton.styleFrom(
              foregroundColor: _red,
              padding: EdgeInsets.symmetric(vertical: 10),
              side: BorderSide(color: Colors.red.shade100)),
        )),
        SizedBox(width: 8),
        Expanded(
            child: ElevatedButton(
          onPressed: () => _handleAcceptOrder(order),
          child: Text('Accept'),
          style: ElevatedButton.styleFrom(
              backgroundColor: _primaryTeal,
              foregroundColor: _white,
              padding: EdgeInsets.symmetric(vertical: 10),
              ),
        )),
      ]);
    } else if (isCompletedOrRejected) {
      // Completed Tab: View Details button
      actionButton = SizedBox(
          width: double.infinity,
          child: OutlinedButton(
            onPressed: () => _navigateToOrderDetails(order),
            child: Text('View Details'),
            style: OutlinedButton.styleFrom(
                foregroundColor: _darkTeal,
                padding: EdgeInsets.symmetric(vertical: 10),
                side: BorderSide(color: _lightTeal)),
          ));
    } else if (isActive) {
      // Active Tab: Button depends on the specific active status
      String buttonText = "View Details"; // Default for assigned?
      VoidCallback onPressedAction = () => _navigateToOrderDetails(order);

      if (status == Order.STATUS_RIDER_ACCEPTED) buttonText = "Go to Details / Start";
      if (status == Order.STATUS_PICKED_UP) buttonText = "Go to Details / Navigate";
      if (status == Order.STATUS_ON_THE_WAY) buttonText = "View Progress / Verify";
      if (status == Order.STATUS_DELIVERED) buttonText = "Go to Details / Verify Code";

      actionButton = SizedBox(
          width: double.infinity,
          child: ElevatedButton(
            onPressed: onPressedAction, // Navigate to details screen for all active
            child: Text(buttonText),
            style: ElevatedButton.styleFrom(
                backgroundColor: _primaryTeal,
                foregroundColor: _white,
                padding: EdgeInsets.symmetric(vertical: 10),
                ),
          ));
    }

    // Card Structure
    return Card(
      elevation: 2,
      shadowColor: Colors.grey.withOpacity(0.3),
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
      child: InkWell( // Make the whole card tappable to go to details (except for available)
        onTap: isAvailable ? null : () => _navigateToOrderDetails(order),
        borderRadius: BorderRadius.circular(12),
        child: Padding(
          padding: const EdgeInsets.all(16.0),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Row( // Top Row: Order ID and Status Chip
                mainAxisAlignment: MainAxisAlignment.spaceBetween,
                children: [
                  Text('Order #${order.orderId}',
                      style: TextStyle(
                          fontWeight: FontWeight.bold,
                          fontSize: 16,
                          color: _darkTeal)),
                  Container(
                    padding: EdgeInsets.symmetric(horizontal: 10, vertical: 4),
                    decoration: BoxDecoration(
                        color: statusColor.withOpacity(0.15),
                        borderRadius: BorderRadius.circular(20)),
                    child: Text(statusText,
                        style: TextStyle(
                            color: statusColor,
                            fontWeight: FontWeight.bold,
                            fontSize: 12)),
                  ),
                ]
              ),
              Text(DateFormat('M/d/yyyy, h:mm a').format(order.orderDate), // Order Date/Time
                  style: TextStyle(color: _grey, fontSize: 12)),
              SizedBox(height: 12),
              // Pickup Address
              _buildAddressRow(Icons.storefront, order.pickupAddress),
              SizedBox(height: 6),
              // Delivery Address
              _buildAddressRow(Icons.location_on_outlined, order.simplifiedDeliveryAddress),
              SizedBox(height: 12),
              // Info Row: Distance, Time, Earnings
              _buildOrderInfoRow(order),
              SizedBox(height: 16),
              // Action Button(s) if applicable
              if (actionButton != null) actionButton,
            ],
          ),
        ),
      ),
    );
  }

