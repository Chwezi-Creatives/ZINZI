// Pinned TabBar Delegate for NestedScrollView
class _SliverAppBarDelegate extends SliverPersistentHeaderDelegate {
  _SliverAppBarDelegate(this._tabBar);

  final TabBar _tabBar;

  @override
  double get minExtent => _tabBar.preferredSize.height;
  @override
  double get maxExtent => _tabBar.preferredSize.height;

  @override
  Widget build(BuildContext context, double shrinkOffset, bool overlapsContent) {
    // Added Material for elevation and background consistency
    return Material(
        color: _white, // Ensures background matches scaffold
        elevation: 1, // Slight elevation to distinguish pinned tab bar
        child: _tabBar
    );
  }

  @override
  bool shouldRebuild(_SliverAppBarDelegate oldDelegate) {
    return false; // Keep false if tab bar itself doesn't change
  }
}


// ================================================
// === ORDER DETAILS SCREEN (with Mapbox Map) =====
// ================================================
class OrderDetailsScreen extends StatefulWidget {
  final Order order;
  final String transporterId;
  final Future<void> Function() onStatusUpdate;
  final bool autoNavigatePreference; // Pass user preference

  const OrderDetailsScreen({
    Key? key,
    required this.order,
    required this.transporterId,
    required this.onStatusUpdate,
    required this.autoNavigatePreference,
  }) : super(key: key);

  @override
  _OrderDetailsScreenState createState() => _OrderDetailsScreenState();
}

class _OrderDetailsScreenState extends State<OrderDetailsScreen> {
  late Order _currentOrder;
  final TextEditingController _verificationCodeController = TextEditingController();
  bool _isUpdatingStatus = false;
  bool _isVerificationVisible = false;

  // --- Mapbox State (Using mapbox_maps_flutter) ---
  mapbox.MapboxMap? _mapController; // Use alias
  mapbox.Point? _originPoint; // Pickup coordinates // Use alias
  mapbox.Point? _destinationPoint; // Delivery coordinates // Use alias
  mapbox.Point? _currentUserLocation; // Track current location // Use alias
  bool _isMapboxReady = false; // Tracks if map style is loaded
  bool _isNavigating = false; // Tracks if route is active
  bool _hasLocationPermission = false;
  bool _isFetchingRoute = false;
  StreamSubscription<geolocator.Position>? _positionStreamSubscription; // Specify geolocator.Position
  CancelableOperation? _locationListenerToken; // For mapbox location listener

  // Route drawing constants
  static const String ROUTE_SOURCE_ID = "route-source";
  static const String ROUTE_LAYER_ID = "route-layer";
  static const double ARRIVAL_THRESHOLD_METERS = 50.0;

  // --- End Mapbox State ---


  @override
  void initState() {
    super.initState();
    _currentOrder = widget.order;
    _isVerificationVisible = _currentOrder.orderStatus == Order.STATUS_DELIVERED; // Show verification if already delivered

    // Parse coordinates on init
    _originPoint = _currentOrder.pickupCoordinates;
    _destinationPoint = _currentOrder.deliveryCoordinates;

    // Check location permission status
    _checkAndRequestLocationPermission();

    // If order status is already 'on_the_way' or 'delivered', potentially show route immediately
    if ((_currentOrder.orderStatus == Order.STATUS_ON_THE_WAY || _currentOrder.orderStatus == Order.STATUS_DELIVERED) && widget.autoNavigatePreference) {
       _isNavigating = true; // Set navigation state
       // The route will be fetched/drawn in onStyleLoaded if _isNavigating is true
    }
  }

  @override
  void dispose() {
    _verificationCodeController.dispose();
     // VERY IMPORTANT: Cancel mapbox listeners and streams
     _locationListenerToken?.cancel();
     _positionStreamSubscription?.cancel();
     _mapController?.dispose(); // Dispose map controller
    super.dispose();
  }

  // --- Location Permission Handling ---
  Future<void> _checkAndRequestLocationPermission() async {
    bool serviceEnabled;
    geolocator.LocationPermission permission; // Specify geolocator.LocationPermission

    // Test if location services are enabled.
    serviceEnabled = await geolocator.Geolocator.isLocationServiceEnabled();
    if (!serviceEnabled) {
      _showErrorSnackBar('Location services are disabled. Please enable them.');
       setStateIfMounted(() => _hasLocationPermission = false); // Use setStateIfMounted
      return;
    }

    permission = await geolocator.Geolocator.checkPermission();
    if (permission == geolocator.LocationPermission.denied) {
      permission = await geolocator.Geolocator.requestPermission();
      if (permission == geolocator.LocationPermission.denied) {
         _showErrorSnackBar('Location permissions are denied.');
          setStateIfMounted(() => _hasLocationPermission = false); // Use setStateIfMounted
         return;
      }
    }

    if (permission == geolocator.LocationPermission.deniedForever) {
      // Permissions are denied forever, handle appropriately.
       _showErrorSnackBar('Location permissions are permanently denied, we cannot request permissions.');
       setStateIfMounted(() => _hasLocationPermission = false); // Use setStateIfMounted
      return;
    }

    // When we reach here, permissions are granted
    print("Location permission granted.");
    setStateIfMounted(() => _hasLocationPermission = true); // Use setStateIfMounted
    // If map is ready, enable location component now
    if (_mapController != null && _isMapboxReady) {
      _enableLocationTracking();
    }
    // Start listening to geolocator stream for proximity checks
     _startGeolocatorPositionStream();
  }


  // --- Mapbox Setup and Control ---

   void _onMapCreated(mapbox.MapboxMap controller) { // Use alias
     print("Map created");
     _mapController = controller;
     // Style loaded callback (_onStyleLoaded) is more reliable for setup after this
   }

   void _onStyleLoaded() {
     print("Style loaded");
     setStateIfMounted(() { // Use setStateIfMounted
       _isMapboxReady = true;
     });

     // Enable location puck if permission granted
     if (_hasLocationPermission) {
       _enableLocationTracking();
     }

     // If we are in navigating state (e.g., returned to screen), fetch/draw route
     if (_isNavigating) {
        if (_originPoint != null && _destinationPoint != null) {
          _fetchAndDrawRoute(_originPoint!, _destinationPoint!);
        } else {
           print("Cannot draw route: Origin or destination point is null.");
           _showErrorSnackBar("Missing coordinates for routing.");
        }
     } else if (_destinationPoint != null) {
       // If not navigating, just move camera to destination
        _mapController?.flyTo(
          mapbox.CameraOptions(center: _destinationPoint, zoom: 14.0), // Use alias
          mapbox.MapAnimationOptions(duration: 1500) // Use alias
        );
     }
   }

    // Enable the location puck on the map
   Future<void> _enableLocationTracking() async {
     if (!_isMapboxReady || _mapController == null || !_hasLocationPermission) return;
     print("Enabling location tracking component...");
     try {
        // Simplified approach for older versions (like 0.2.7 syntax)
        await _mapController!.location.updateSettings(mapbox.LocationComponentSettings(enabled: true)); // Use alias
       print("Location tracking enabled (basic).");
     } catch (e) {
       print("Error enabling location tracking: $e");
       _showErrorSnackBar("Could not show current location: $e");
     }
   }


   // Start listening to position updates from Geolocator
   void _startGeolocatorPositionStream() {
      if (!_hasLocationPermission) return;
       _positionStreamSubscription?.cancel(); // Cancel existing subscription
       // Use geolocator.LocationSettings
       final geolocator.LocationSettings locationSettings = geolocator.LocationSettings(
         accuracy: geolocator.LocationAccuracy.high,
         distanceFilter: 10, // Notify every 10 meters change
       );
       _positionStreamSubscription = geolocator.Geolocator.getPositionStream(locationSettings: locationSettings)
           .listen((geolocator.Position position) { // Specify geolocator.Position
             if (!mounted) return;
            // print("Geolocator Position: ${position.latitude}, ${position.longitude}");
            // mapbox_maps_flutter Position expects (longitude, latitude)
             _currentUserLocation = mapbox.Point(coordinates: mapbox.Position(position.longitude, position.latitude)); // Use alias

              // Center map on user if navigating and preference allows
              if (_isNavigating && widget.autoNavigatePreference && _mapController != null) {
                 // Use explicit null check for heading to resolve warning
                 final currentBearing = position.heading != null ? position.heading! : 0.0;
                 _mapController!.flyTo(
                   mapbox.CameraOptions( // Use alias
                     center: _currentUserLocation,
                     zoom: 16.0,
                     bearing: currentBearing // Use checked bearing
                   ),
                   mapbox.MapAnimationOptions(duration: 1000) // Smooth animation // Use alias
                 );
              }

             // Check for arrival if navigating
             if (_isNavigating && _destinationPoint != null) {
               double distance = geolocator.Geolocator.distanceBetween(
                 position.latitude,
                 position.longitude,
                 _destinationPoint!.coordinates.lat as double,
                 _destinationPoint!.coordinates.lng as double,
               );
              // print("Distance to destination: $distance meters");
               if (distance < ARRIVAL_THRESHOLD_METERS) {
                 print("Arrival threshold reached!");
                 _handleArrival();
               }
             }
           },
           onError: (error) {
              print("Geolocator position stream error: $error");
              _showErrorSnackBar("Error getting location updates: $error");
           });
   }

   // Fetch route from API and draw on map
   Future<void> _fetchAndDrawRoute(mapbox.Point origin, mapbox.Point destination) async { // Use alias
     if (!_isMapboxReady || _mapController == null) {
       print("Cannot draw route: Map not ready.");
       return;
     }
     if (_isFetchingRoute) return; // Avoid multiple calls

     print("Fetching and drawing route...");
     setStateIfMounted(() => _isFetchingRoute = true); // Use setStateIfMounted
     _showLoadingSnackbar("Calculating route..."); // Show loading indicator

     try {
        // Use the raw HTTP call method as Directions helper isn't available in v2.7.0
        final routeData = await TransporterApiService.fetchRoute(origin, destination);
         _dismissLoadingSnackbar(); // Hide loading indicator

        if (routeData == null || routeData['geometry'] == null) {
           throw Exception("Failed to fetch route data or route geometry missing.");
        }
        final geometry = routeData['geometry']; // GeoJSON geometry as Map<String, dynamic>

        // Ensure previous route layers/sources are removed
        await _removeRoute();

        // Add route source
        // GeoJsonSource expects a String or Uint8List. Encode the geometry map.
        await _mapController!.style.addSource(
            mapbox.GeoJsonSource(id: ROUTE_SOURCE_ID, data: json.encode(geometry)) // Use alias
        );

        // Add route layer
        await _mapController!.style.addLayer(mapbox.LineLayer( // Use alias
            id: ROUTE_LAYER_ID,
            sourceId: ROUTE_SOURCE_ID,
            lineColor: Colors.blue.value, // Use Colors.blue.value for integer color
            lineWidth: 5.0,
            lineOpacity: 0.8,
            lineJoin: mapbox.LineJoin.ROUND, // Use alias
            lineCap: mapbox.LineCap.ROUND // Use alias
        ));
        print("Route drawn successfully.");

         // Adjust camera to fit route bounds
          final bounds = mapbox.CoordinateBounds( // Use alias
              southwest: origin, // Use Point directly
              northeast: destination, // Use Point directly
              infiniteBounds: false);

          // Use mapbox.MbxEdgeInsets for padding
          final padding = mapbox.MbxEdgeInsets(top: 50.0, left: 50.0, bottom: 100.0, right: 50.0);

          // Delay slightly to ensure layout?
          await Future.delayed(Duration(milliseconds: 100));
          _mapController?.cameraForCoordinateBounds(bounds, padding).then((cameraOptions) {
                _mapController?.flyTo(cameraOptions, mapbox.MapAnimationOptions(duration: 1500)); // Use alias
          });


     } catch (e) {
       print("Error fetching or drawing route: $e");
       _dismissLoadingSnackbar();
       _showErrorSnackBar("Could not calculate route: ${e.toString()}");
     } finally {
        if(mounted) setStateIfMounted(() => _isFetchingRoute = false); // Use setStateIfMounted
     }
   }

    // Remove route line from map
   Future<void> _removeRoute() async {
     if (_mapController == null) return;
     try {
       // Check if layer exists before removing
       final layerExists = await _mapController!.style.styleLayerExists(ROUTE_LAYER_ID);
       if (layerExists == true) {
         await _mapController!.style.removeStyleLayer(ROUTE_LAYER_ID);
         print("Route layer removed.");
       }
        // Check if source exists before removing
        final sourceExists = await _mapController!.style.styleSourceExists(ROUTE_SOURCE_ID);
        if (sourceExists == true) {
          await _mapController!.style.removeStyleSource(ROUTE_SOURCE_ID);
          print("Route source removed.");
        }
     } catch (e) {
       print("Error removing route layer/source: $e");
       // Non-critical error, maybe layer/source didn't exist
     }
   }


  // --- Status Logic & Actions ---

  String _getStatusText(String apiStatus) { // Keep local version for details screen
     switch (apiStatus.toLowerCase()) {
       case Order.STATUS_PENDING: return 'Pending';
       case Order.STATUS_ASSIGNED: return 'Assigned';
       case Order.STATUS_RIDER_ACCEPTED: return 'Accepted';
       case Order.STATUS_PICKED_UP: return 'Picked Up';
       case Order.STATUS_ON_THE_WAY: return 'On The Way';
       case Order.STATUS_DELIVERING: return 'Delivering';
       case Order.STATUS_DELIVERED: return 'Arrived / Verify Code';
       case Order.STATUS_COMPLETED: return 'Completed';
       case Order.STATUS_CANCELLED: return 'Cancelled';
       case Order.STATUS_RIDER_REJECTED: return 'Rejected';
       default: return apiStatus.replaceAll('_', ' ').split(' ').map((word) => word[0].toUpperCase() + word.substring(1)).join(' ');
     }
   }


  // Determines the next logical status based on the current one
  String? _getNextStatus() {
    switch (_currentOrder.orderStatus) {
      case Order.STATUS_RIDER_ACCEPTED:
        return Order.STATUS_PICKED_UP; // After accepting, next step is pickup
      case Order.STATUS_PICKED_UP:
        return Order.STATUS_ON_THE_WAY; // After pickup, next is driving
      case Order.STATUS_ON_THE_WAY:
         // Arrived status, next step is verification (handled by arrival detection/button)
        return Order.STATUS_DELIVERED;
      // No automatic next step from DELIVERED or COMPLETED/CANCELLED etc.
      default:
        return null;
    }
  }

  // Should verification be required for this order? (Assume yes for now)
  bool _needsVerification() => true; // Or check order type/settings if needed

  // Text for the main action button
  String _getActionButtonText() {
    switch (_currentOrder.orderStatus) {
      case Order.STATUS_RIDER_ACCEPTED:
        // Need to distinguish pickup from starting navigation if required by UI
        // Let's assume "Start Delivery" implies going to pickup AND starting navigation flow
        return 'Start Delivery (Navigate)';
      case Order.STATUS_PICKED_UP:
        return 'Start Navigation'; // Explicitly start map navigation after pickup
      case Order.STATUS_ON_THE_WAY:
        return 'View Progress / Verify'; // Implies user has arrived or wants to check map
      case Order.STATUS_DELIVERED:
        return 'Verify Code'; // Button shown after reaching destination
      case Order.STATUS_COMPLETED:
        return 'Delivery Complete';
      case Order.STATUS_CANCELLED:
      case Order.STATUS_RIDER_REJECTED:
        return 'Order Cancelled/Rejected';
      default:
        return 'Update Status'; // Fallback
    }
  }

  // Can the main action button be shown?
  bool _canShowActionButton() {
    // Show button for states where the rider needs to take the next action
    return [
      Order.STATUS_RIDER_ACCEPTED,
      Order.STATUS_PICKED_UP,
      Order.STATUS_ON_THE_WAY,
      Order.STATUS_DELIVERED,
    ].contains(_currentOrder.orderStatus);
  }

  // --- Main Action Button Handler ---
  Future<void> _handleActionButtonPress() async {
    String currentStatus = _currentOrder.orderStatus;

    if (_isUpdatingStatus) return; // Prevent double taps

    // --- Rider Accepted: Mark Picked Up & Start Driving ---
    if (currentStatus == Order.STATUS_RIDER_ACCEPTED) {
      // Mark as picked up first (API call)
       final nextStatus = _getNextStatus(); // Should be 'picked_up'
       if (nextStatus != null) {
          bool success = await _performStatusUpdate(nextStatus);
          if (success && mounted) {
             // If picked up successfully, THEN start navigation flow
             await _startDrivingNavigation();
          }
       }
    }
    // --- Picked Up: Start Navigation ---
    else if (currentStatus == Order.STATUS_PICKED_UP) {
        await _startDrivingNavigation();
    }
    // --- On The Way: Handle Arrival (or Re-center Map) ---
    else if (currentStatus == Order.STATUS_ON_THE_WAY) {
       // This button might now mean "I've arrived" or just "Show Map"
       // Let's assume it manually triggers the arrival state update.
       // Arrival should ideally be detected automatically via location stream.
       // If clicked manually, update status to Delivered.
       print("Manually marking as arrived...");
       await _performStatusUpdate(Order.STATUS_DELIVERED);
       if(mounted) setStateIfMounted(() => _isVerificationVisible = _needsVerification()); // Use setStateIfMounted
       _removeRoute(); // Stop showing route line
       if (_positionStreamSubscription != null) {
          // Pause or modify stream if needed after arrival? Keep listening for now.
       }
       setStateIfMounted(() => _isNavigating = false); // Exit navigation map mode // Use setStateIfMounted
    }
    // --- Delivered: Trigger Verification ---
    else if (currentStatus == Order.STATUS_DELIVERED) {
      if (_isVerificationVisible) {
        await _handleVerifyCode(); // Call the code verification logic
      } else {
        // Should not happen if logic is correct, but handle gracefully
        setStateIfMounted(() => _isVerificationVisible = true); // Use setStateIfMounted
        _showSnackBar("Please enter verification code.", isError: false);
      }
    } else {
      print("No action defined for status: $currentStatus");
    }
  }


  // --- Helper to Start the Driving/Navigation Flow ---
  Future<void> _startDrivingNavigation() async {
      if (_originPoint == null || _destinationPoint == null) {
        _showErrorSnackBar("Missing coordinates for navigation.");
        return;
      }
      if (!_hasLocationPermission) {
          _showErrorSnackBar("Location permission needed to navigate.");
          _checkAndRequestLocationPermission(); // Try requesting again
          return;
      }
      if (!_isMapboxReady || _mapController == null) {
         _showErrorSnackBar("Map is not ready for navigation.");
         return;
      }

       // Update status to 'on_the_way' if not already set
       if (_currentOrder.orderStatus != Order.STATUS_ON_THE_WAY) {
          bool success = await _performStatusUpdate(Order.STATUS_ON_THE_WAY);
          if (!success) {
            _showErrorSnackBar("Failed to update status before navigating.");
            return; // Don't navigate if status update fails
          }
       }

       // Set navigation state and trigger route drawing/location tracking
       setStateIfMounted(() { // Use setStateIfMounted
         _isNavigating = true;
         // _activeNavigationOrder = _currentOrder; // Removed as unused
       });

       // Ensure location tracking is active
       await _enableLocationTracking();
       // Fetch and draw the route
       await _fetchAndDrawRoute(_originPoint!, _destinationPoint!);
       // Start Geolocator stream if not already running
       _startGeolocatorPositionStream();
   }


  // --- Handle Arrival Logic ---
  Future<void> _handleArrival() async {
    // Prevent multiple arrival triggers
    if (!mounted || !_isNavigating || _currentOrder.orderStatus == Order.STATUS_DELIVERED || _currentOrder.orderStatus == Order.STATUS_COMPLETED) {
      return;
    }
     print("Handling Arrival...");

    // 1. Stop showing the route line
    await _removeRoute();

    // 2. Update Status to Delivered (API Call)
    // Perform update in background, update UI optimistically first
    setStateIfMounted(() {
      _isNavigating = false; // Exit map navigation mode
      _currentOrder = _currentOrder.copyWith(orderStatus: Order.STATUS_DELIVERED);
      _isVerificationVisible = _needsVerification(); // Show verification card
      _showSuccessSnackBar("You have arrived at the destination!");
    });

    // 3. Make API call to confirm delivered status
    await _performStatusUpdate(Order.STATUS_DELIVERED, showLoading: false); // Update status via API silently

    // 4. Cancel or modify location listener if needed
    // Keep Geolocator stream running for now, maybe useful on verification screen?
    // _positionStreamSubscription?.cancel(); // Optional: stop precise tracking

  }

  // --- Verification using NEW /rr/rc endpoint ---
  Future<void> _handleVerifyCode() async {
    String code = _verificationCodeController.text.trim();
    if (code.length != 6) {
      _showErrorSnackBar('Please enter a 6-digit verification code.');
      return;
    }
    FocusScope.of(context).unfocus(); // Hide keyboard
    _showLoadingSnackbar("Verifying Code & Completing...");
    setStateIfMounted(() => _isUpdatingStatus = true); // Use setStateIfMounted

    try {
      // Call the NEW verification endpoint
      bool success = await TransporterApiService.verifyDeliveryCode(_currentOrder.orderId, code);

       // No need to dismiss loading snackbar here, handled in finally

       if (success && mounted) {
        _showSuccessSnackBar('Delivery completed successfully!');
        // Update local state to 'completed'
        setStateIfMounted(() { // Use setStateIfMounted
          _currentOrder = _currentOrder.copyWith(orderStatus: Order.STATUS_COMPLETED);
          _isVerificationVisible = false; // Hide verification card
        });
        await widget.onStatusUpdate(); // Refresh list on previous screen

        // Optionally pop after a short delay
        await Future.delayed(Duration(seconds: 1));
        if (mounted) Navigator.pop(context);

      } else if (!success && mounted) {
         // API returned false but didn't throw (shouldn't happen with current API logic)
         throw Exception("Verification API returned false.");
      }
      // If verifyDeliveryCode throws an exception, it's caught below

    } catch (e) {
      print("Verification failed: $e");
      if (mounted) _showErrorSnackBar('Verification failed: ${e.toString()}');
      // Clear code field on error?
      _verificationCodeController.clear();
    } finally {
      if (mounted) {
         _dismissLoadingSnackbar(); // Dismiss loading indicator
         setStateIfMounted(() => _isUpdatingStatus = false); // Use setStateIfMounted
       }
    }
  }

  // Helper to perform non-verification status updates
  Future<bool> _performStatusUpdate(String newStatus, {bool showLoading = true}) async {
    if (_isUpdatingStatus) return false; // Avoid concurrent updates

    if (showLoading) _showLoadingSnackbar("Updating status to ${_getStatusText(newStatus)}...");
    setStateIfMounted(() => _isUpdatingStatus = true); // Use setStateIfMounted
    bool success = false;
    try {
      success = await TransporterApiService.updateOrderStatusByTransporter(
          _currentOrder.orderId, newStatus, widget.transporterId);

      if (success && mounted) {
        if(showLoading) _showSuccessSnackBar('Order status updated to ${_getStatusText(newStatus)}!');
        // Update local state *after* successful API call
        setStateIfMounted(() { // Use setStateIfMounted
          _currentOrder = _currentOrder.copyWith(orderStatus: newStatus);
           // If moving away from delivered, hide verification
           if(newStatus != Order.STATUS_DELIVERED) {
             _isVerificationVisible = false;
           }
        });
        await widget.onStatusUpdate(); // Notify previous screen
      } else if (!success && mounted) {
        // API call returned false explicitly
         throw Exception("Update status API failed silently or component unmounted.");
      }
    } catch (e) {
      print("Failed to update order status to $newStatus: $e");
      if (mounted && showLoading) _showErrorSnackBar('Failed to update status: ${e.toString()}');
      success = false; // Ensure success is false on error
    } finally {
      if (mounted) {
         if(showLoading) _dismissLoadingSnackbar();
         setStateIfMounted(() => _isUpdatingStatus = false); // Use setStateIfMounted
       }
    }
    return success; // Return status of the operation
  }

  // Removed _promptForVerification as it's unused

  // --- Build Methods ---
  @override
  Widget build(BuildContext context) {
    String status = _currentOrder.orderStatus;
    Color statusColor;
    String statusText = _getStatusText(status); // User-friendly status

    switch (status) {
      case Order.STATUS_COMPLETED: statusColor = _green; break;
      case Order.STATUS_CANCELLED:
      case Order.STATUS_RIDER_REJECTED: statusColor = _red; break;
      case Order.STATUS_DELIVERED: statusColor = _orange; break; // Orange when arrived, pre-verification
      case Order.STATUS_PENDING: statusColor = _grey; break;
      default: statusColor = _primaryTeal; break; // Active statuses
    }

    return Scaffold(
      backgroundColor: _white,
      appBar: AppBar(
        backgroundColor: _white,
        foregroundColor: _darkTeal,
        elevation: 1,
        title: Row(
            mainAxisAlignment: MainAxisAlignment.spaceBetween,
            children: [
              Text('Order #${_currentOrder.orderId}', style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold, color: _darkTeal)),
              Container(
                  padding: EdgeInsets.symmetric(horizontal: 10, vertical: 4),
                  decoration: BoxDecoration(
                      color: statusColor.withOpacity(0.15),
                      borderRadius: BorderRadius.circular(20)),
                  child: Text(statusText, style: TextStyle(color: statusColor, fontWeight: FontWeight.bold, fontSize: 12))),
            ]
        ),
        leading: IconButton(
            icon: Icon(Icons.arrow_back, color: _darkTeal),
            onPressed: () => Navigator.of(context).pop()),
      ),
      body: Column( // Use Column instead of Stack for simpler layout switching
         children: [
            // Map Area
            Expanded(
              flex: _isNavigating ? 3 : 1, // Give map more space when navigating
              child: _buildMapArea(),
            ),

            // Details Area (Scrollable)
            Expanded(
               flex: 2, // Give details less space than map when navigating
               child: ListView(
                 padding: const EdgeInsets.all(16.0),
                 children: [
                    _buildOrderDetailsCard(),
                    SizedBox(height: 16),
                    _buildStatusTimelineCard(),
                    SizedBox(height: 16),
                    if (_isVerificationVisible) ...[
                      _buildDeliveryVerificationCard(),
                      SizedBox(height: 16),
                    ],
                    // Action button at the bottom of details
                    if (_canShowActionButton())
                      Padding(
                        padding: const EdgeInsets.only(top: 8.0, bottom: 16.0), // Add bottom padding
                        child: SizedBox(
                          width: double.infinity,
                          child: ElevatedButton(
                            onPressed: _isUpdatingStatus ? null : _handleActionButtonPress,
                            child: _isUpdatingStatus
                                ? SizedBox(height: 20, width: 20, child: CircularProgressIndicator(strokeWidth: 2, color: _white))
                                : Text(_getActionButtonText()),
                            style: ElevatedButton.styleFrom(
                                backgroundColor: _primaryTeal,
                                foregroundColor: _white,
                                padding: EdgeInsets.symmetric(vertical: 12),
                                shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(8))),
                          ),
                        ),
                      ),
                 ],
               ),
             ),
         ],
      ),
    );
  }

  // Builds the Mapbox Map Widget or placeholders
  Widget _buildMapArea() {
    // Show map only if token is available
     if (mapboxAccessToken == null || mapboxAccessToken!.isEmpty) {
       return _buildMapPlaceholder("Map requires setup (Missing Token)");
     }
    // Show permission request/denied message
     if (!_hasLocationPermission) {
        return _buildMapPlaceholder("Location permission needed for map.", showRequestButton: true);
     }

     // Show the actual map
     return mapbox.MapWidget( // Use alias
       // Remove accessToken prop - not used directly in constructor for this version
       // accessToken: mapboxAccessToken!,
       onMapCreated: _onMapCreated,
       onStyleLoadedListener: _onStyleLoaded,
        // Use mapbox_maps_flutter's CameraOptions for initial position
       cameraOptions: mapbox.CameraOptions( // Use alias
         // Start near destination or origin if available
         // Ensure center is a Point
         center: _destinationPoint ?? _originPoint ?? mapbox.Point(coordinates: mapbox.Position(-115.1738779, 36.1175275)), // Fallback coordinates // Ensure Point is used
         zoom: 11.0,
       ),
       // Use standard Mapbox style URLs
       styleUri: "mapbox://styles/mapbox/streets-v11", // Or specify URL directly
       // styleString: "mapbox://styles/mapbox/streets-v11", // Or specify URL directly
       // Gestures are typically enabled by default, removing explicit recognizers
     );
  }

  // Placeholder widget for map area
  Widget _buildMapPlaceholder(String message, {bool showRequestButton = false}) {
     return Container(
       color: _lightGrey,
       child: Center(
         child: Padding(
           padding: const EdgeInsets.all(20.0),
           child: Column(
             mainAxisAlignment: MainAxisAlignment.center,
             children: [
               Icon(Icons.map_outlined, size: 40, color: _grey),
               SizedBox(height: 12),
               Text(
                 message,
                 textAlign: TextAlign.center,
                 style: TextStyle(color: _grey, fontSize: 16),
               ),
                if(showRequestButton) ...[
                   SizedBox(height: 16),
                   ElevatedButton(
                      onPressed: _checkAndRequestLocationPermission,
                      child: Text("Grant Permission"),
                      style: ElevatedButton.styleFrom(backgroundColor: _primaryTeal, foregroundColor: _white),
                   )
                ]
             ],
           ),
         ),
       ),
     );
   }


