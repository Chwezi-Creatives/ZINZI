  // Helper for text fields
  Widget _buildTextField(TextEditingController controller, String label,
      {bool enabled = true,
      TextInputType keyboardType = TextInputType.text,
      List<TextInputFormatter>? inputFormatters,
      int? maxLength,
      String? Function(String?)? validator}) {
    return TextFormField(
      controller: controller,
      keyboardType: keyboardType,
      enabled: enabled,
      inputFormatters: inputFormatters,
      maxLength: maxLength,
      style: TextStyle(color: enabled ? _darkTeal : _grey),
      decoration: InputDecoration(
        labelText: label,
        labelStyle: TextStyle(color: _grey),
        filled: true,
        fillColor: enabled ? _lightGrey : Colors.grey[200], // Fix: use grey[200]
        border: OutlineInputBorder(
            borderRadius: BorderRadius.circular(8.0), borderSide: BorderSide.none),
        focusedBorder: OutlineInputBorder(
            borderRadius: BorderRadius.circular(8.0), borderSide: BorderSide(color: _primaryTeal)),
        disabledBorder: OutlineInputBorder(
            borderRadius: BorderRadius.circular(8.0), borderSide: BorderSide(color: Colors.grey[300]!)), // Fix: use grey[300]!
        contentPadding: EdgeInsets.symmetric(horizontal: 16, vertical: 12),
        floatingLabelBehavior: FloatingLabelBehavior.auto, // Or always
        counterText: "", // Hide counter if maxLength is used
      ),
       validator: validator, // Add validator
       autovalidateMode: AutovalidateMode.onUserInteraction, // Validate on interaction
    );
  }

  // Helper for saving personal info
  Future<void> _savePersonalChanges() async {
     if (!(_profileEditFormKey.currentState?.validate() ?? false)) {
       _showErrorSnackBar("Please fix errors in the form.");
       return;
     }
     if (_isUploadingProfileImage) {
       _showErrorSnackBar("Please wait for image upload to complete.");
       return;
     }

     setState(() => _isSavingProfile = true);
     _showLoadingSnackbar("Saving Profile...");

     String? uploadedImageUrl = _transporterProfile?.profileImageUrl; // Start with current URL

     try {
       // 1. Upload Image if a new one was picked
       if (_profileImageFile != null) {
         setState(() => _isUploadingProfileImage = true);
         _dismissLoadingSnackbar(); // Dismiss saving snackbar
         _showLoadingSnackbar("Uploading image...");
         try {
           uploadedImageUrl = await TransporterApiService.uploadImageToImgur(_profileImageFile!);
           if (uploadedImageUrl == null) throw Exception("Image upload returned null URL.");
           setState(() => _isUploadingProfileImage = false);
           _dismissLoadingSnackbar(); // Dismiss upload snackbar
           _showLoadingSnackbar("Saving Profile..."); // Show saving again
         } catch (imgErr) {
           setState(() => _isUploadingProfileImage = false);
           _dismissLoadingSnackbar();
           // Let the outer catch handle showing the error, but throw specific message
           throw Exception("Image upload failed: $imgErr");
         }
       }

       // 2. Prepare Update Data
       Map<String, dynamic> updateData = {
         // Only include fields if they actually changed
         if (_nameController.text != _transporterProfile?.name)
            'name': _nameController.text,
         if (_phoneController.text != (_transporterProfile?.phoneNumber ?? ''))
            'phone_number': _phoneController.text.isEmpty ? null : _phoneController.text, // Send null if empty
         if (_addressController.text != (_transporterProfile?.address ?? ''))
            'address': _addressController.text.isEmpty ? null : _addressController.text, // Send null if empty
          // Only include image URL if it changed (either new upload or cleared?)
         if (uploadedImageUrl != _transporterProfile?.profileImageUrl)
           'profile_image_url': uploadedImageUrl,
       };

       // Remove null values unless API expects them explicitly
        updateData.removeWhere((key, value) => value == null && key != 'profile_image_url' && key != 'phone_number' && key != 'address'); // Keep null for specific fields if intended

       // 3. Send Update Request if data changed
       if (updateData.isNotEmpty) {
         print("Sending profile update data: $updateData");
         bool success = await TransporterApiService.updateTransporterProfile(widget.transporterId, updateData);
         if (!success) throw Exception("Profile update API call failed.");

         // 4. Refresh Profile Data from Server
         await _fetchTransporterProfileAndUpdate(); // Fetch latest profile data

         // 5. Clear picked image file state only on success
         setState(() { _profileImageFile = null; });
         _dismissLoadingSnackbar();
         _showSuccessSnackBar('Profile updated successfully!');

       } else {
         _dismissLoadingSnackbar();
         _showSnackBar("No changes detected to save.", isError: false);
       }

     } catch (e) {
       print("Failed to save personal changes: $e");
       _dismissLoadingSnackbar();
       if (mounted) _showErrorSnackBar('Failed to save profile: ${e.toString()}');
     } finally {
       // Ensure loading states are reset
       if (mounted) {
          setState(() {
            _isSavingProfile = false;
             _isUploadingProfileImage = false; // Also reset image upload flag here
           });
       }
     }
   }

  // Helper for saving vehicle info
  Future<void> _saveVehicleChanges() async {
     setState(() => _isSavingProfile = true);
     _showLoadingSnackbar("Saving Vehicle Info...");

     Map<String, dynamic> updateData = {
        // Include only if changed from current profile state
       if (_vehicleMakeController.text != (_transporterProfile?.vehicleMake ?? ''))
          'vehicle_make': _vehicleMakeController.text.isEmpty ? null : _vehicleMakeController.text,
       if (_vehicleModelController.text != (_transporterProfile?.vehicleModel ?? ''))
          'vehicle_model': _vehicleModelController.text.isEmpty ? null : _vehicleModelController.text,
       if (_vehicleYearController.text != (_transporterProfile?.vehicleYear ?? ''))
          'vehicle_year': _vehicleYearController.text.isEmpty ? null : _vehicleYearController.text,
       if (_licensePlateController.text != (_transporterProfile?.licensePlate ?? ''))
          'license_plate': _licensePlateController.text.isEmpty ? null : _licensePlateController.text,
       if (_vehicleColorController.text != (_transporterProfile?.vehicleColor ?? ''))
          'vehicle_color': _vehicleColorController.text.isEmpty ? null : _vehicleColorController.text,
     };

     // Remove unchanged fields / nulls if API doesn't expect them
     updateData.removeWhere((key, value) => value == null);

     try {
       if (updateData.isNotEmpty) {
         print("Sending vehicle update data: $updateData");
         bool success = await TransporterApiService.updateTransporterProfile(widget.transporterId, updateData);
         if (!success) throw Exception("Vehicle update API call failed.");

         await _fetchTransporterProfileAndUpdate(); // Refresh profile
         _dismissLoadingSnackbar();
         _showSuccessSnackBar('Vehicle information updated!');
       } else {
         _dismissLoadingSnackbar();
         _showSnackBar("No vehicle changes detected.", isError: false);
       }
     } catch (e) {
       _dismissLoadingSnackbar();
       print("Failed to save vehicle changes: $e");
       if (mounted) _showErrorSnackBar('Failed to save vehicle info: ${e.toString()}');
     } finally {
       if (mounted) setState(() => _isSavingProfile = false);
     }
   }

  // Helpers for Preferences/Settings Tab
   Widget _buildPreferenceSectionTitle(String title, String subtitle) {
     return Padding(
       padding: const EdgeInsets.only(top: 8.0, bottom: 8.0), // Adjusted padding
       child: Column(
         crossAxisAlignment: CrossAxisAlignment.start,
         children: [
           Text(title, style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold, color: _darkTeal)),
           if (subtitle.isNotEmpty)
              Text(subtitle, style: TextStyle(color: _grey, fontSize: 13)),
         ]
       )
     );
   }

   Widget _buildSwitchPreference(String title, String subtitle, bool value, ValueChanged<bool> onChanged) {
     return SwitchListTile(
       contentPadding: EdgeInsets.zero,
       title: Text(title, style: TextStyle(fontWeight: FontWeight.w600, color: _darkTeal, fontSize: 15)),
       subtitle: subtitle.isNotEmpty ? Text(subtitle, style: TextStyle(color: _grey, fontSize: 13)) : null,
       value: value,
       onChanged: onChanged,
       activeColor: _white, // Thumb color when ON
       activeTrackColor: _primaryTeal, // Track color when ON
       inactiveThumbColor: _white, // Thumb color when OFF
       inactiveTrackColor: Colors.grey[300]!, // Fix: Use grey[300]!
       dense: true, // Reduces vertical padding
     );
   }

    // Update and save preference immediately
   Future<void> _updatePreference(String key, bool value) async {
     setState(() {
       switch (key) {
         case 'notifyNewOrders': _notifyNewOrders = value; break;
         case 'notifyStatusUpdates': _notifyStatusUpdates = value; break;
         case 'notifyEarnings': _notifyEarnings = value; break;
         case 'notifyPromotions': _notifyPromotions = value; break;
         // case 'useDarkMode': _useDarkMode = value; break; // Removed
         case 'soundAlerts': _soundAlerts = value; break;
         case 'autoNavigate': _autoNavigate = value; break;
       }
     });

     try {
       SharedPreferences prefs = await SharedPreferences.getInstance();
       await prefs.setBool(key, value);
       // Optional: Show brief confirmation
       // _showSnackBar("$key preference saved.", isError: false, durationSeconds: 1);
     } catch (e) {
       _showErrorSnackBar("Failed to save preference: $e");
       // Optionally revert state if saving fails
       // setState(() { ... revert value ... });
     }
   }


  // Image Picker Logic
  Future<void> _pickProfileImage() async {
     final image_picker.ImagePicker picker = image_picker.ImagePicker(); // Use alias
     try {
       final image_picker.XFile? image = await picker.pickImage( // Use alias
           source: image_picker.ImageSource.gallery, // Use alias
           imageQuality: 70, // Compress image slightly
           maxWidth: 800 // Resize image
           );
       if (image != null && mounted) {
         setState(() {
           _profileImageFile = File(image.path); // Store file for preview and upload
         });
         _showSnackBar("Image selected. Press 'Save Personal Info' to apply.", isError: false);
       }
     } catch (e) {
       print("Image picking error: $e");
       if (mounted) _showErrorSnackBar('Failed to pick image: ${e.toString()}');
     }
   }

} // End of _TransporterDashNewState

