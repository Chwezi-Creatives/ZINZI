// Use conditional import to handle web platform
import 'dart:io' if (dart.library.js) 'dart:html' as io;
import 'package:flutter/foundation.dart' show kIsWeb;

// This class is only used on non-web platforms
class MyHttpOverrides extends io.HttpOverrides {
  final List<int> certificate;

  MyHttpOverrides(this.certificate);

  @override
  io.HttpClient createHttpClient(io.SecurityContext? context) {
    // Skip for web platform
    if (kIsWeb) {
      throw UnsupportedError('HttpOverrides not supported on web platform');
    }

    // Create a SecurityContext with custom trusted certificates
    final securityContext = io.SecurityContext(withTrustedRoots: true);
    try {
      securityContext.setTrustedCertificatesBytes(certificate);
    } catch (e) {
      print('Error setting trusted certificates: $e');
    }

    // Create an HttpClient using the customized SecurityContext
    final client = super.createHttpClient(securityContext);

    // Accept self-signed certificates
    client.badCertificateCallback =
        (io.X509Certificate cert, String host, int port) {
      print('Accepting self-signed certificate from $host:$port');
      return true;
    };

    return client;
  }
}
